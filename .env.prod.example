# Safeai-desk/backend/.env.prod.example
SPRING_PROFILES_ACTIVE=prod

SAFEAI_BACKEND_IMAGE_TAG=0.1.0
SAFEAI_FRONTEND_IMAGE_TAG=0.1.0

# PostgreSQL container/bootstrap
POSTGRES_DB=safeai
POSTGRES_USER=safeai
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/safeai

# Runtime DB account
SAFEAI_DB_APP_USER=safeai_app
SAFEAI_DB_APP_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD

# Flyway account
SAFEAI_DB_MIGRATOR_USER=safeai_migrator
SAFEAI_DB_MIGRATOR_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_DB_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Должен быть Base64/Base64URL от минимум 32
# криптографически случайных байт.
#
# Генерация:
# openssl rand -base64 32
SAFEAI_JWT_SECRET=REPLACE_WITH_VALID_BASE64_32_BYTE_SECRET!
SAFEAI_JWT_EXPIRATION_MINUTES=15
SAFEAI_JWT_ISSUER=https://your-domain.com
SAFEAI_JWT_AUDIENCE=safeai-desk-api

SAFEAI_PLATFORM_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Укажите точный адрес edge/backend proxy.
# Не используйте 0.0.0.0/0.
SAFEAI_SECURITY_CLIENT_IP_TRUSTED_PROXY_CIDRS=172.28.0.10/32

SAFEAI_CORS_ALLOWED_ORIGINS=https://your-domain.com

SAFEAI_AUTH_COOKIES_SECURE=true
SAFEAI_AUTH_COOKIES_SAME_SITE=Lax
SAFEAI_AUTH_ACCESS_TOKEN_MAX_AGE=15m
SAFEAI_AUTH_REFRESH_TOKEN_MAX_AGE=30d
SAFEAI_AUTH_REFRESH_TOKEN_ABSOLUTE_MAX_AGE=90d
SAFEAI_AUTH_REUSE_DETECTION_RETENTION=7d
SAFEAI_AUTH_COOKIES_DOMAIN=
SAFEAI_AUTH_ACCESS_COOKIE_NAME=safeai-access
SAFEAI_AUTH_REFRESH_COOKIE_NAME=safeai-refresh

SAFEAI_AI_PROVIDER=openai

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_INPUT_TOKENS=64000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_MAX_RESPONSE_CHARS=100000
OPENAI_MAX_RESPONSE_BODY_BYTES=2097152
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=60s
OPENAI_STORE=false

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_INPUT_TOKENS=64000
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_MAX_RESPONSE_CHARS=100000
ANTHROPIC_MAX_RESPONSE_BODY_BYTES=2097152
ANTHROPIC_CONNECT_TIMEOUT=5s
ANTHROPIC_READ_TIMEOUT=60s

# Пока нет доказанной безопасной retry/idempotency модели
# provider-вызова — только один attempt.
SAFEAI_AI_RETRY_ENABLED=false
SAFEAI_AI_RETRY_MAX_ATTEMPTS=1
SAFEAI_AI_RETRY_INITIAL_BACKOFF=250ms
SAFEAI_AI_RETRY_MAX_BACKOFF=2s
SAFEAI_AI_RETRY_MAX_RETRY_AFTER=10s
SAFEAI_AI_RETRY_TOTAL_TIMEOUT=75s

SAFEAI_RATE_LIMIT_REDIS_KEY_PREFIX=safeai:prod
SAFEAI_RATE_LIMIT_REDIS_KEY_VERSION=v1
SAFEAI_RATE_LIMIT_REDIS_HMAC_SECRET=REPLACE_WITH_STRONG_RANDOM_HMAC_SECRET

SAFEAI_RATE_LIMIT_LOGIN_ENABLED=true
SAFEAI_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
SAFEAI_RATE_LIMIT_LOGIN_IP_LIMIT=100
SAFEAI_RATE_LIMIT_LOGIN_WINDOW=10m

SAFEAI_RATE_LIMIT_AI_MESSAGES_ENABLED=true
SAFEAI_RATE_LIMIT_AI_MESSAGES_USER_LIMIT_PER_HOUR=20
SAFEAI_RATE_LIMIT_AI_MESSAGES_ADMIN_LIMIT_PER_HOUR=100
SAFEAI_RATE_LIMIT_AI_MESSAGES_ORGANIZATION_LIMIT_PER_HOUR=1000

SAFEAI_CHAT_DETAILS_MESSAGE_LIMIT=50
SAFEAI_CHAT_HISTORY_TURN_LIMIT=50
SAFEAI_CHAT_MAX_CHAT_PAGE_SIZE=100
SAFEAI_CHAT_MAX_MESSAGE_PAGE_SIZE=100
SAFEAI_CHAT_MAX_MESSAGE_CHARS=16000

SAFEAI_CHAT_PROCESSING_LEASE=3m
SAFEAI_CHAT_LEASE_RENEWAL_THREADS=4
SAFEAI_CHAT_MAX_ACTIVE_LEASE_WATCHDOGS=1000

SAFEAI_CHAT_LOCK_KEY_PREFIX=safeai:prod:chat-lock
SAFEAI_CHAT_LOCK_TTL=2m
SAFEAI_CHAT_LOCK_RENEWAL_THREADS=4
SAFEAI_CHAT_LOCK_MAX_ACTIVE_LOCKS=1000
SAFEAI_CHAT_LOCK_SHUTDOWN_TIMEOUT=5s

SAFEAI_CHAT_QUOTA_ENABLED=true
SAFEAI_CHAT_QUOTA_RESERVATION_INPUT_TOKENS=16000
SAFEAI_CHAT_QUOTA_RESERVATION_OUTPUT_TOKENS=2048
SAFEAI_CHAT_QUOTA_RESERVATION_COST_USD=1.000000000000
SAFEAI_CHAT_QUOTA_PERIOD_ZONE=UTC

SAFEAI_CHAT_RECOVERY_ENABLED=true
SAFEAI_CHAT_RECOVERY_BATCH_SIZE=100
SAFEAI_CHAT_RECOVERY_MAX_BATCHES_PER_RUN=20
SAFEAI_CHAT_RECOVERY_CRON="0 * * * * *"

# Production security correctness не должна
# зависеть от кеша user status.
SAFEAI_USER_STATUS_CACHE_ENABLED=false
SAFEAI_USER_STATUS_CACHE_TTL=15s
SAFEAI_USER_STATUS_CACHE_KEY_PREFIX=safeai:prod:user-status

# HSTS ставит внешний HTTPS Nginx.
SAFEAI_HSTS_ENABLED=false

SAFEAI_USER_DELETION_RETENTION=7d

SAFEAI_AUDIT_OUTBOX_BATCH_SIZE=100
SAFEAI_AUDIT_OUTBOX_POLL_DELAY_MS=1000

SAFEAI_AUDIT_RETENTION_ENABLED=true
SAFEAI_AUDIT_RETENTION_PERIOD=1095d
SAFEAI_AUDIT_RETENTION_BATCH_SIZE=10000
SAFEAI_AUDIT_RETENTION_MAX_BATCHES_PER_RUN=10
SAFEAI_AUDIT_RETENTION_CRON="0 30 3 * * *"
SAFEAI_AUDIT_RETENTION_ZONE=UTC

SAFEAI_USAGE_DEFAULT_RANGE=30d
SAFEAI_USAGE_MAX_RANGE=366d
SAFEAI_USAGE_MAX_LIVE_RANGE=31d
SAFEAI_USAGE_MAX_PAGE_SIZE=200
SAFEAI_USAGE_QUERY_TIMEOUT=10s
SAFEAI_USAGE_SLOW_QUERY_THRESHOLD=2s
SAFEAI_USAGE_FETCH_SIZE=200
SAFEAI_USAGE_MAX_CONCURRENT_REPORTS=4

SAFEAI_USAGE_ROLLUP_ENABLED=true
SAFEAI_USAGE_ROLLUP_CRON="0 */10 * * * *"
SAFEAI_USAGE_ROLLUP_LOOKBACK_DAYS=3
SAFEAI_USAGE_ROLLUP_BACKFILL_DAYS_PER_RUN=31
SAFEAI_USAGE_ROLLUP_ADVISORY_LOCK_KEY=8026001
SAFEAI_USAGE_ROLLUP_STATEMENT_TIMEOUT=2m