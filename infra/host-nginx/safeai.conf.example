# SafeAI-Desk/infra/host-nginx/safeai.conf.example
# Example host-level TLS terminator for SafeAI Desk.
# This file is a template and MAY be committed to Git.
#
# Before deployment:
# - replace safeai.example.com;
# - replace certificate paths if needed;
# - verify the TLS policy against the installed Nginx version;
# - copy the resulting real config to the host Nginx configuration directory.
#
# Traffic:
# Internet -> HTTPS host Nginx -> 127.0.0.1:8080 -> container Nginx -> backend

server {
    listen 80;
    listen [::]:80;

    server_name safeai.example.com;

    server_tokens off;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    http2 on;

    server_name safeai.example.com;

    server_tokens off;

    ssl_certificate
        /etc/letsencrypt/live/safeai.example.com/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/safeai.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_session_cache shared:SAFEAI_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Не добавлять includeSubDomains, пока не доказано,
    # что ВСЕ текущие и будущие subdomain работают только по HTTPS.
    add_header Strict-Transport-Security
        "max-age=31536000"
        always;

    add_header X-Content-Type-Options
        nosniff
        always;

    add_header Referrer-Policy
        strict-origin-when-cross-origin
        always;

    # Должно быть не меньше Spring:
    # max-file-size=25MB
    # max-request-size=26MB
    client_max_body_size 26m;

    proxy_connect_timeout 5s;
    proxy_send_timeout 95s;
    proxy_read_timeout 95s;
    send_timeout 95s;

    location / {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;

        # Не принимаем клиентскую X-Forwarded-For цепочку как доверенную.
        # Host Nginx является внешней trust boundary и начинает цепочку заново.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Request-Id $request_id;

        # Не повторять mutating/API request на другой upstream автоматически.
        proxy_next_upstream off;
    }
}