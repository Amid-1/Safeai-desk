# SafeAI-Desk/infra/config/pricing.yml.example
#
# Production pricing TEMPLATE. This file MAY be committed to Git.
#
# Real production file:
#   /etc/safeai/config/pricing.yml
#
# The real file is host-managed and MUST NOT be committed.
#
# Every price must correspond to the exact resolved provider model.
# Do not guess prices and do not silently treat an unknown model as free.
#
# `version` is an immutable identifier of the tariff snapshot used for
# accounting/audit, for example:
#
#   openai-gpt-4.1-2026-09-verified
#
# validate-prod.sh must reject deployment while REPLACE_WITH remains.

safeai:
  ai:
    pricing:
      models:
        - model: gpt-4.1
          input-usd-per-1m-tokens: REPLACE_WITH_VERIFIED_INPUT_PRICE
          output-usd-per-1m-tokens: REPLACE_WITH_VERIFIED_OUTPUT_PRICE
          currency: USD
          version: REPLACE_WITH_IMMUTABLE_PRICE_VERSION

        - model: claude-opus-4-8
          input-usd-per-1m-tokens: REPLACE_WITH_VERIFIED_INPUT_PRICE
          output-usd-per-1m-tokens: REPLACE_WITH_VERIFIED_OUTPUT_PRICE
          currency: USD
          version: REPLACE_WITH_IMMUTABLE_PRICE_VERSION