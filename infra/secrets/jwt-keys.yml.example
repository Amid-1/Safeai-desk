# SafeAI-Desk/infra/secrets/jwt-keys.yml.example
# This file is a template and MAY be committed.
# The real file must live outside the repository, for example:
#   /etc/safeai/secrets/jwt-keys.yml
#
# public-key  -> X.509 SubjectPublicKeyInfo / BEGIN PUBLIC KEY
# private-key -> PKCS#8 / BEGIN PRIVATE KEY
# key id      -> [A-Za-z0-9._-]{1,64}

app:
  security:
    jwt:
      active-key-id: prod-2026-08-01

      keys:
        - id: prod-2026-08-01
          public-key: |-
            -----BEGIN PUBLIC KEY-----
            REPLACE_WITH_ACTIVE_PUBLIC_KEY
            -----END PUBLIC KEY-----
          private-key: |-
            -----BEGIN PRIVATE KEY-----
            REPLACE_WITH_ACTIVE_PRIVATE_KEY
            -----END PRIVATE KEY-----

        # During rotation, keep the previous public key for verification for at
        # least the maximum lifetime of access tokens already issued with it.
        # The previous private key should normally be removed after cutover.
        #
        # - id: prod-2026-07-01
        #   public-key: |-
        #     -----BEGIN PUBLIC KEY-----
        #     REPLACE_WITH_PREVIOUS_PUBLIC_KEY
        #     -----END PUBLIC KEY-----
