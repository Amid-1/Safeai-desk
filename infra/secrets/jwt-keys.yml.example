# Этот файл является ШАБЛОНОМ и может храниться в Git.
# Реальный файл должен находиться вне репозитория:
#   /etc/safeai/secrets/jwt-keys.yml
#
# Форматы:
#   public-key  -> X.509 SubjectPublicKeyInfo / BEGIN PUBLIC KEY
#   private-key -> PKCS#8 / BEGIN PRIVATE KEY
#
# active-key-id должен соответствовать:
#   [A-Za-z0-9._-]{1,64}

app:
  security:
    jwt:
      active-key-id: prod-2026-08-01

      keys:
        - id: prod-2026-08-01
          public-key: |-
            -----BEGIN PUBLIC KEY-----
            REPLACE_WITH_ACTIVE_PUBLIC_KEY
            -----END PUBLIC KEY-----
          private-key: |-
            -----BEGIN PRIVATE KEY-----
            REPLACE_WITH_ACTIVE_PRIVATE_KEY
            -----END PRIVATE KEY-----

        # При ротации предыдущий ключ оставляется только для verification
        # на срок не меньше максимального TTL уже выданных access-токенов.
        #
        # - id: prod-2026-07-01
        #   public-key: |-
        #     -----BEGIN PUBLIC KEY-----
        #     REPLACE_WITH_PREVIOUS_PUBLIC_KEY
        #     -----END PUBLIC KEY-----
