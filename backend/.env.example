# SafeAI-Desk/backend/.env.example
#
# LOCAL environment template.
# Этот файл КОММИТИТСЯ.
# Реальный backend/.env НЕ коммитится.
#
# Docker Compose:
#   запускать из корня проекта с:
#   docker compose --env-file backend/.env -f infra/docker-compose.local.yml ...
#
# Spring Boot при обычном ./mvnw spring-boot:run сам .env не загружает.
# Для запуска backend на host задавайте environment через IDE/shell.
# Реальные RSA PEM храните только в backend/.local-secrets/ или другом
# локальном secret storage и передавайте через environment.

SPRING_PROFILES_ACTIVE=local

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safeai
SPRING_DATASOURCE_USERNAME=safeai
SPRING_DATASOURCE_PASSWORD=change-me-postgres-password

POSTGRES_DB=safeai
POSTGRES_USER=safeai
POSTGRES_PASSWORD=change-me-postgres-password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ---------------------------------------------------------------------------
# JWT / RS256
# ---------------------------------------------------------------------------
SAFEAI_JWT_EXPIRATION_MINUTES=15
SAFEAI_JWT_ISSUER=http://localhost:8080
SAFEAI_JWT_AUDIENCE=safeai-desk-api
SAFEAI_JWT_ACTIVE_KEY_ID=local-2026-01

# Не храните реальные PEM в Git.
# Для запуска backend на host:
#
# export SAFEAI_JWT_PUBLIC_KEY="$(cat .local-secrets/jwt-public.pem)"
# export SAFEAI_JWT_PRIVATE_KEY="$(cat .local-secrets/jwt-private.pem)"
#
# Для Docker Compose эти значения можно экспортировать в shell перед
# `docker compose up --profile full`, чтобы shell environment имел
# приоритет над пустыми значениями ниже.
SAFEAI_JWT_PUBLIC_KEY=
SAFEAI_JWT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Local MinIO / Knowledge storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=safeai
MINIO_ROOT_PASSWORD=change-me-minio-password

SAFEAI_KNOWLEDGE_STORAGE_TYPE=s3
SAFEAI_KNOWLEDGE_STORAGE_ENDPOINT=http://localhost:9000
SAFEAI_KNOWLEDGE_STORAGE_ACCESS_KEY=safeai
SAFEAI_KNOWLEDGE_STORAGE_SECRET_KEY=change-me-minio-password
SAFEAI_KNOWLEDGE_STORAGE_BUCKET=safeai-knowledge
SAFEAI_KNOWLEDGE_MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------
# Knowledge embedding
# ---------------------------------------------------------------------------
SAFEAI_KNOWLEDGE_EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SAFEAI_KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
SAFEAI_KNOWLEDGE_EMBEDDING_MAX_INPUT_CHARS=20000
SAFEAI_KNOWLEDGE_EMBEDDING_CONNECT_TIMEOUT=5s
SAFEAI_KNOWLEDGE_EMBEDDING_READ_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Knowledge OCR
# ---------------------------------------------------------------------------
SAFEAI_KNOWLEDGE_OCR_PROVIDER=disabled
SAFEAI_KNOWLEDGE_OCR_ENDPOINT=
KNOWLEDGE_OCR_API_KEY=
SAFEAI_KNOWLEDGE_OCR_ALLOWED_HOSTS=
SAFEAI_KNOWLEDGE_OCR_MIN_NATIVE_CHARS=20
SAFEAI_KNOWLEDGE_OCR_CONNECT_TIMEOUT=5s
SAFEAI_KNOWLEDGE_OCR_READ_TIMEOUT=2m
SAFEAI_KNOWLEDGE_OCR_MAX_RESPONSE_BYTES=16777216

# ---------------------------------------------------------------------------
# Knowledge ingestion / retrieval / RAG
# ---------------------------------------------------------------------------
SAFEAI_KNOWLEDGE_INGESTION_ENABLED=true
SAFEAI_KNOWLEDGE_INGESTION_POLL_DELAY=2s
SAFEAI_KNOWLEDGE_INGESTION_BATCH_SIZE=4
SAFEAI_KNOWLEDGE_INGESTION_PROCESSING_LEASE=3m
SAFEAI_KNOWLEDGE_INGESTION_EXTRACTION_TIMEOUT=60s
SAFEAI_KNOWLEDGE_INGESTION_EXTRACTION_THREADS=2
SAFEAI_KNOWLEDGE_INGESTION_MAX_ATTEMPTS=5
SAFEAI_KNOWLEDGE_INGESTION_INITIAL_BACKOFF=10s
SAFEAI_KNOWLEDGE_INGESTION_MAX_BACKOFF=10m
SAFEAI_KNOWLEDGE_INGESTION_MAX_EXTRACTED_CHARS=2000000
SAFEAI_KNOWLEDGE_INGESTION_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
SAFEAI_KNOWLEDGE_INGESTION_CHUNK_SIZE_CHARS=1200
SAFEAI_KNOWLEDGE_INGESTION_CHUNK_OVERLAP_CHARS=150

SAFEAI_KNOWLEDGE_RETRIEVAL_MAX_QUERY_CHARS=4000
SAFEAI_KNOWLEDGE_RETRIEVAL_MAX_TOP_K=20
SAFEAI_KNOWLEDGE_RETRIEVAL_CANDIDATE_LIMIT=100
SAFEAI_KNOWLEDGE_RETRIEVAL_RRF_K=60

SAFEAI_KNOWLEDGE_RAG_TOP_K=8
SAFEAI_KNOWLEDGE_RAG_MAX_CONTEXT_CHARS=24000
SAFEAI_KNOWLEDGE_RAG_MAX_CHUNK_CHARS=6000

# Reconciliation остаётся выключенным до отдельной приёмки recovery/chaos path.
SAFEAI_KNOWLEDGE_STORAGE_RECONCILIATION_ENABLED=false
SAFEAI_KNOWLEDGE_STORAGE_RECONCILIATION_POLL_DELAY=5m

# ---------------------------------------------------------------------------
# Platform / CORS / auth
# ---------------------------------------------------------------------------
SAFEAI_PLATFORM_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
SAFEAI_CORS_ALLOWED_ORIGINS=http://localhost:5173

SAFEAI_AUTH_COOKIES_SECURE=false
SAFEAI_AUTH_COOKIES_SAME_SITE=Lax
SAFEAI_AUTH_ACCESS_TOKEN_MAX_AGE=15m
SAFEAI_AUTH_REFRESH_TOKEN_MAX_AGE=30d
SAFEAI_AUTH_REFRESH_TOKEN_ABSOLUTE_MAX_AGE=90d
SAFEAI_AUTH_REUSE_DETECTION_RETENTION=7d
SAFEAI_AUTH_COOKIES_DOMAIN=
SAFEAI_AUTH_ACCESS_COOKIE_NAME=safeai-access
SAFEAI_AUTH_REFRESH_COOKIE_NAME=safeai-refresh

SAFEAI_AUTH_REFRESH_CLEANUP_BATCH_SIZE=200
SAFEAI_AUTH_REFRESH_CLEANUP_MAX_BATCHES_PER_RUN=100

SAFEAI_HSTS_ENABLED=false

# ---------------------------------------------------------------------------
# AI provider / context / retry
# ---------------------------------------------------------------------------
SAFEAI_AI_PROVIDER=mock

SAFEAI_AI_CONTEXT_MAX_USER_MESSAGE_CHARS=16000
SAFEAI_AI_CONTEXT_MAX_INSTRUCTION_CHARS=32000
SAFEAI_AI_CONTEXT_MAX_HISTORY_MESSAGES=100
SAFEAI_AI_CONTEXT_MAX_MESSAGE_CHARS=50000
SAFEAI_AI_CONTEXT_MAX_TOTAL_INPUT_CHARS=250000
SAFEAI_AI_CONTEXT_CHARS_PER_ESTIMATED_TOKEN=3
SAFEAI_AI_CONTEXT_MESSAGE_OVERHEAD_TOKENS=8
SAFEAI_AI_CONTEXT_SAFETY_MARGIN_TOKENS=1024

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_INPUT_TOKENS=64000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_MAX_RESPONSE_CHARS=100000
OPENAI_MAX_RESPONSE_BODY_BYTES=2097152
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=60s
OPENAI_STORE=false

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_INPUT_TOKENS=64000
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_MAX_RESPONSE_CHARS=100000
ANTHROPIC_MAX_RESPONSE_BODY_BYTES=2097152
ANTHROPIC_CONNECT_TIMEOUT=5s
ANTHROPIC_READ_TIMEOUT=60s

SAFEAI_AI_RETRY_ENABLED=false
SAFEAI_AI_RETRY_MAX_ATTEMPTS=1
SAFEAI_AI_RETRY_INITIAL_BACKOFF=250ms
SAFEAI_AI_RETRY_MAX_BACKOFF=2s
SAFEAI_AI_RETRY_MAX_RETRY_AFTER=10s
SAFEAI_AI_RETRY_TOTAL_TIMEOUT=65s

# ---------------------------------------------------------------------------
# Rate limit
# ---------------------------------------------------------------------------
SAFEAI_RATE_LIMIT_REDIS_KEY_PREFIX=safeai:local
SAFEAI_RATE_LIMIT_REDIS_KEY_VERSION=v1
SAFEAI_RATE_LIMIT_REDIS_HMAC_SECRET=change-me-local-rate-limit-hmac-secret

SAFEAI_RATE_LIMIT_LOGIN_ENABLED=true
SAFEAI_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
SAFEAI_RATE_LIMIT_LOGIN_IP_LIMIT=30
SAFEAI_RATE_LIMIT_LOGIN_WINDOW=10m

SAFEAI_RATE_LIMIT_REFRESH_ENABLED=true
SAFEAI_RATE_LIMIT_REFRESH_IP_LIMIT=600
SAFEAI_RATE_LIMIT_REFRESH_WINDOW=1m

SAFEAI_RATE_LIMIT_AI_MESSAGES_ENABLED=true
SAFEAI_RATE_LIMIT_AI_MESSAGES_USER_LIMIT_PER_HOUR=20
SAFEAI_RATE_LIMIT_AI_MESSAGES_ADMIN_LIMIT_PER_HOUR=100
SAFEAI_RATE_LIMIT_AI_MESSAGES_ORGANIZATION_LIMIT_PER_HOUR=1000

# ---------------------------------------------------------------------------
# Chat
# ---------------------------------------------------------------------------
SAFEAI_CHAT_DETAILS_MESSAGE_LIMIT=50
SAFEAI_CHAT_HISTORY_TURN_LIMIT=50
SAFEAI_CHAT_MAX_CHAT_PAGE_SIZE=100
SAFEAI_CHAT_MAX_MESSAGE_PAGE_SIZE=100
SAFEAI_CHAT_MAX_MESSAGE_CHARS=16000

SAFEAI_CHAT_PROCESSING_LEASE=3m
SAFEAI_CHAT_LEASE_RENEWAL_THREADS=4
SAFEAI_CHAT_MAX_ACTIVE_LEASE_WATCHDOGS=1000

SAFEAI_CHAT_LOCK_KEY_PREFIX=safeai:local:chat-lock
SAFEAI_CHAT_LOCK_TTL=4m
SAFEAI_CHAT_LOCK_RENEWAL_THREADS=4
SAFEAI_CHAT_LOCK_MAX_ACTIVE_LOCKS=1000
SAFEAI_CHAT_LOCK_SHUTDOWN_TIMEOUT=5s

SAFEAI_CHAT_QUOTA_ENABLED=true
SAFEAI_CHAT_QUOTA_RESERVATION_INPUT_TOKENS=16000
SAFEAI_CHAT_QUOTA_RESERVATION_OUTPUT_TOKENS=2048
SAFEAI_CHAT_QUOTA_RESERVATION_COST_USD=1.000000000000
SAFEAI_CHAT_QUOTA_PERIOD_ZONE=UTC

SAFEAI_CHAT_RECOVERY_ENABLED=false
SAFEAI_CHAT_RECOVERY_BATCH_SIZE=100
SAFEAI_CHAT_RECOVERY_MAX_BATCHES_PER_RUN=20

# Cron намеренно не дублируется здесь: безопасный default находится
# в application.yml, а local recovery выключен.

# ---------------------------------------------------------------------------
# User / audit / usage
# ---------------------------------------------------------------------------
SAFEAI_USER_STATUS_CACHE_ENABLED=true
SAFEAI_USER_STATUS_CACHE_TTL=60s
SAFEAI_USER_STATUS_CACHE_KEY_PREFIX=safeai:local:user-status

SAFEAI_USER_DELETION_RETENTION=7d

SAFEAI_AUDIT_OUTBOX_BATCH_SIZE=100
SAFEAI_AUDIT_OUTBOX_POLL_DELAY_MS=1000

SAFEAI_AUDIT_RETENTION_ENABLED=false

SAFEAI_USAGE_ROLLUP_ENABLED=false
