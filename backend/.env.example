# Safeai-desk/backend/.env.example
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safeai
SPRING_PROFILES_ACTIVE=local

SPRING_DATASOURCE_USERNAME=safeai
SPRING_DATASOURCE_PASSWORD=safeai_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SAFEAI_JWT_SECRET=change-me-change-me-change-me-32-bytes-min
SAFEAI_JWT_EXPIRATION_MINUTES=60
SAFEAI_JWT_ISSUER=safeai-desk

SAFEAI_AI_PROVIDER=mock

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

SAFEAI_CORS_ALLOWED_ORIGINS=http://localhost:5173

SAFEAI_AUTH_COOKIES_SECURE=false
SAFEAI_AUTH_COOKIES_SAME_SITE=Lax
SAFEAI_AUTH_ACCESS_TOKEN_MAX_AGE=15m
SAFEAI_AUTH_REFRESH_TOKEN_MAX_AGE=30d

SAFEAI_RATE_LIMIT_LOGIN_ENABLED=true
SAFEAI_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
SAFEAI_RATE_LIMIT_LOGIN_IP_LIMIT=30
SAFEAI_RATE_LIMIT_LOGIN_WINDOW=10m

SAFEAI_RATE_LIMIT_REDIS_KEY_PREFIX=safeai:local

SAFEAI_RATE_LIMIT_AI_MESSAGES_ENABLED=true
SAFEAI_RATE_LIMIT_AI_MESSAGES_USER_LIMIT_PER_HOUR=20
SAFEAI_RATE_LIMIT_AI_MESSAGES_ADMIN_LIMIT_PER_HOUR=100

SAFEAI_CHAT_LOCK_KEY_PREFIX=safeai:local:chat-lock
SAFEAI_CHAT_LOCK_TTL=120s
SAFEAI_CHAT_DETAILS_MESSAGE_LIMIT=50
SAFEAI_CHAT_HISTORY_MESSAGE_LIMIT=30

SAFEAI_AI_RETRY_ENABLED=true
SAFEAI_AI_RETRY_MAX_ATTEMPTS=2
SAFEAI_AI_RETRY_INITIAL_BACKOFF=250ms
SAFEAI_AI_RETRY_MAX_BACKOFF=2s

OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=60s
SAFEAI_AI_OPENAI_MAX_RESPONSE_CHARS=100000

ANTHROPIC_CONNECT_TIMEOUT=5s
ANTHROPIC_READ_TIMEOUT=60s
SAFEAI_AI_ANTHROPIC_MAX_RESPONSE_CHARS=100000