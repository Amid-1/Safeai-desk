# Safeai-desk/backend/.env.prod
SPRING_PROFILES_ACTIVE=prod

SAFEAI_BACKEND_IMAGE_TAG=0.1.0
SAFEAI_FRONTEND_IMAGE_TAG=0.1.0

POSTGRES_DB=safeai
POSTGRES_USER=safeai
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

SAFEAI_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
SAFEAI_JWT_EXPIRATION_MINUTES=15
SAFEAI_JWT_ISSUER=safeai-desk
SAFEAI_JWT_AUDIENCE=safeai-desk-api

SAFEAI_SECURITY_CLIENT_IP_TRUSTED_PROXY_CIDRS=172.28.0.0/24

SAFEAI_CORS_ALLOWED_ORIGINS=https://your-domain.com

SAFEAI_AUTH_COOKIES_SECURE=true
SAFEAI_AUTH_COOKIES_SAME_SITE=Lax
SAFEAI_AUTH_ACCESS_TOKEN_MAX_AGE=15m
SAFEAI_AUTH_REFRESH_TOKEN_MAX_AGE=30d

SAFEAI_AI_PROVIDER=openai

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=60s
OPENAI_STORE=false
SAFEAI_AI_OPENAI_MAX_RESPONSE_CHARS=100000

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_CONNECT_TIMEOUT=5s
ANTHROPIC_READ_TIMEOUT=60s
SAFEAI_AI_ANTHROPIC_MAX_RESPONSE_CHARS=100000

SAFEAI_AI_RETRY_ENABLED=true
SAFEAI_AI_RETRY_MAX_ATTEMPTS=2
SAFEAI_AI_RETRY_INITIAL_BACKOFF=250ms
SAFEAI_AI_RETRY_MAX_BACKOFF=2s

SAFEAI_RATE_LIMIT_REDIS_KEY_PREFIX=safeai:prod

SAFEAI_RATE_LIMIT_LOGIN_ENABLED=true
SAFEAI_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
SAFEAI_RATE_LIMIT_LOGIN_IP_LIMIT=30
SAFEAI_RATE_LIMIT_LOGIN_WINDOW=10m

SAFEAI_RATE_LIMIT_AI_MESSAGES_ENABLED=true
SAFEAI_RATE_LIMIT_AI_MESSAGES_USER_LIMIT_PER_HOUR=20
SAFEAI_RATE_LIMIT_AI_MESSAGES_ADMIN_LIMIT_PER_HOUR=100
SAFEAI_RATE_LIMIT_AI_MESSAGES_ORGANIZATION_LIMIT_PER_HOUR=1000

SAFEAI_CHAT_LOCK_KEY_PREFIX=safeai:prod:chat-lock
SAFEAI_CHAT_LOCK_TTL=120s
SAFEAI_CHAT_DETAILS_MESSAGE_LIMIT=50
SAFEAI_CHAT_HISTORY_MESSAGE_LIMIT=30

SAFEAI_USER_STATUS_CACHE_ENABLED=false
SAFEAI_USER_STATUS_CACHE_TTL=60s
SAFEAI_USER_STATUS_CACHE_KEY_PREFIX=safeai:prod:user-status

SAFEAI_USER_DELETION_RETENTION=7d

SAFEAI_AUDIT_OUTBOX_BATCH_SIZE=100
SAFEAI_AUDIT_OUTBOX_POLL_DELAY_MS=1000