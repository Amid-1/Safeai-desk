# SafeAI-Desk/.gitignore

### Build ###
HELP.md
target/
build/
out/
backend/target/

*.class

### Maven / Gradle wrappers ###
# Wrapper JARs are intentionally versioned.
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### STS / Eclipse ###
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

### NetBeans ###
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

### VS Code ###
.vscode/

### Run configurations ###
.run/

### macOS / Windows ###
.DS_Store
Thumbs.db

### Temporary files ###
*~
*.swp
*.swo

### Allure ###
.allure/

### Runtime logs ###
logs/
**/logs/
*.log
*.log.*
**/archived/

### Local/runtime data ###
.local-test-data/
backend/var/
backend/.local-test-data/
docker-compose/docker-logs/

### Environment files ###
.env
.env.*
**/.env
**/.env.*

# Safe templates are versioned.
!**/.env.example
!**/.env.*.example

### Local secrets / RSA ###
.local-secrets/
**/.local-secrets/

# Never commit a real JWT key ring.
jwt-keys.yml
**/jwt-keys.yml

# Version the template only.
!**/jwt-keys.yml.example

### Production deployment secrets/config ###
# Real file-backed secrets must live outside the repository.
infra/secrets/*
!infra/secrets/*.example
!infra/secrets/.gitkeep

# Real production pricing is host-managed:
#   /etc/safeai/config/pricing.yml
# If a local copy is created under infra/config, do not commit it.
infra/config/pricing.yml
!infra/config/pricing.yml.example

# Host-specific enabled Nginx config should be installed outside the repo.
infra/host-nginx/safeai.conf
!infra/host-nginx/safeai.conf.example

### Local helper files ###
commit-message.txt

### Application-specific ###
**/src/main/resources/twitter4j.properties

### Local/unmanaged libraries ###
lib/

.com/
.company/
.udemy/

### Documentation ###
!docs/.gitkeep

### Frontend ###
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local
