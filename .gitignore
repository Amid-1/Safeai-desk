# SafeAI-Desk/.gitignore
# Policy: ignore local data and generated artifacts, NOT source code, tests,
# migrations, lockfiles, CI workflows, or configuration templates.

### Build outputs (Java, Gradle, frontend) ###
HELP.md
target/
build/
out/
dist/
*.class
*.tsbuildinfo
.gradle/

### Maven / Gradle wrapper JARs ARE source-controlled ###
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

### IDE / editors ###
.idea/
*.iws
*.iml
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
.vscode/
.run/

### OS / temporary files ###
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.tmp
*.temp

### Runtime logs and reports ###
logs/
*.log
*.log.*
**/archived/
.allure/
allure-results/
allure-report/

### Python tooling (all directories, including .github/scripts) ###
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
.pyre/
.coverage
.coverage.*
htmlcov/

### Node / package managers / coverage ###
# Covers frontend/, root e2e/, future packages and workspaces.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
coverage/
.nyc_output/
.vite/

### Playwright / browser tests: generated ONLY, not *.spec.* ###
playwright-report/
test-results/
blob-report/
.playwright/

### Local databases, dumps, backups and runtime object storage ###
/backups/
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
.local-test-data/
backend/var/
backend/var.knowledge-objects/
docker-compose/docker-logs/

### Secrets and machine-specific configuration ###
.env
.env.*
**/.env
**/.env.*
# Keep safe, intentionally public templates.
!**/.env.example
!**/.env.*.example
!**/.env.template
!**/.env.*.template
.local-secrets/
**/.local-secrets/
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
jwt-keys.yml
**/jwt-keys.yml
!**/jwt-keys.yml.example

# File-backed deployment secrets and host-only configs.
infra/secrets/*
!infra/secrets/*.example
!infra/secrets/.gitkeep
infra/config/pricing.yml
!infra/config/pricing.yml.example
infra/host-nginx/safeai.conf
!infra/host-nginx/safeai.conf.example

# Local account notes are not production documentation.
/docs/local/

### Personal helpers: keep locally, not in production code changes ###
/README-APPLY-RU.md
/scripts/fix_safeai_*.py
commit-message.txt

### Special project rules ###
**/src/main/resources/twitter4j.properties
lib/
# Frontend source lib/ directories ARE part of production code.
!frontend/src/**/lib/
!frontend/src/**/lib/**
.com/
.company/
.udemy/

### Documentation ###
!docs/.gitkeep
